<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="../css/style.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Wonderlust</title>
</head>
<body> 
    <%- include('header.ejs') %>
    <div class="row mt-3">
        <div class="col-8 offset-3">
    <h3> Listing Details</h3>
    </div>

    <div class="col-6 offset-3">

    <div class="card show-card" >
        <img src="<%= foundListing.image.url %>" class="card-img-top show-img" alt="Lising Image">
        <div class="card-body">
          <h5 class="card-title"><%= foundListing.title %></h5>
          <p>
            <%= foundListing.description %> <br>
            &#x20b9 <%= foundListing.price.toLocaleString("en-IN") %> <br>
            <%= foundListing.location %> <br>
            <%= foundListing.country %>

          </p>
          
        </div>
      </div>
    </div>
</div>

   <div class=" btns">
    <a href="/listings/<%= foundListing._id %>/edit" class="btn  btn-dark col-1 offset-3 add-btn">EDIT</a>
    <form method="POST" action="/listings/<%= foundListing._id %>?_method=DELETE">
        <button class="btn btn-dark offset-5">DELETE</button>
      </form>
    
   </div>
   

   


    <%- include("../includes/footer.ejs") %>
 
</body>
</html>