<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Fix the path to your CSS file -->
    <link rel="stylesheet" href="/css/style.css">
    <title>Edit Listing | WANDERLUST</title>


    <title>WANDERLUST</title>
</head>
<body> 
  <%- include('header.ejs') %>
  <div class="col-8 offset-2">
     
   <div class="row mt-3">

    <h3>Create a New Listing</h3>
    <form method="POST" action="/listings/<%=list._id %>?_method=PUT">
      <div class="mb-3">
        <labelfor="title" class="form-label" >Enter Title</label>
      <input name="listing[title]" value="<%=list.title%>" type="text" class="form-control" />
    </div>
     
    
      <div class="mb-3">
        <labelfor="title" class="form-label" >Enter Title</label>
      <textarea name="listing[description]"  placeholder="enter description" class="form-control"
      > <%=list.description%></textarea>
      </div>
    

      <div class="mb-3">
        <labelfor="title" class="form-label" >Enter Title</label>
      <input class="form-control"
        name="listing[image]" value="<%=list.image.url%>" 
        placeholder="enter image URL/Link"
        type="text"
      />
      </div>
     <div class="row">
      <div class="mb-3 col-md-4">
        <labelfor="title" class="form-label" >Enter Title</label>
      <input class="form-control" name="listing[price]" value="<%=list.price%>"  placeholder="enter price" type="number" />
      </div>
      
      <div class="mb-3 col-md-8">
        <labelfor="title" class="form-label" >Enter Title</label>
      <input class="form-control" name="listing[country]" value="<%=list.country%>"  placeholder="enter country" type="text" />
      </div>
    </div>
      <div class="mb-3">
        <labelfor="title" class="form-label" >Enter Title</label>
      <input class="form-control"
        name="listing[location]" value="<%=list.location%>" 
        placeholder="enter location"
        type="text"
      />
      </div>

      <button type="submit" class="btn btn-secondary add-btn mt-3">Sumbit</button>
    </div>

  </div>
     
    <%- include("../includes/footer.ejs") %>
</body>
</html>